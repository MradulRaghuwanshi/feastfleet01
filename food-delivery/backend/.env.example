PORT=5000
NODE_ENV=development

# Gmail SMTP for Nodemailer.
# Use a Gmail App Password, not your normal Gmail password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# Optional email branding/footer values.
APP_NAME=FeastFleet
RESTAURANT_NAME=FeastFleet
RESTAURANT_PHONE=+91 98765 43210
RESTAURANT_WEBSITE=https://example.com
RESTAURANT_LOGO_URL=https://example.com/logo.png
ADMIN_NOTIFICATION_EMAIL=mradulraghuwanshi@gmail.com
EMAIL_TIMEZONE=Asia/Kolkata

# Optional emergency override. Set false to force COD only.
PAYMENT_ONLINE_ENABLED=true
