rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return userRole() == 'admin';
    }

    // Users — anyone can create (self-register), only owner can read/write their own
    match /users/{userId} {
      allow read:   if true;
      allow create: if true;  // self-registration
      allow update: if true;
    }

    // loginCredentials — write allowed for self-registration, read for auth lookup
    match /loginCredentials/{docId} {
      allow read:   if true;
      allow create: if true;  // self-registration
      allow update: if false;
      allow delete: if false;
    }

    // Restaurants — public read, restricted write
    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if true; // admin manages via backend

      match /menu/{itemId} {
        allow read:  if true;
        allow write: if true;
      }
    }

    // Orders — open read/write for authenticated sessions
    match /orders/{orderId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
    }

    // Feast Coins wallet and immutable wallet history
    match /wallets/{walletId} {
      allow read:   if signedIn() && (request.auth.uid == walletId || isAdmin());
      allow create: if signedIn() && request.auth.uid == walletId;
      allow update: if signedIn() && (request.auth.uid == walletId || isAdmin());

      match /transactions/{transactionId} {
        allow read:   if signedIn() && (request.auth.uid == walletId || isAdmin());
        allow create: if signedIn() && request.auth.uid == walletId;
        allow update, delete: if false;
      }

      match /monthlyArchives/{archiveId} {
        allow read:   if signedIn() && (request.auth.uid == walletId || isAdmin());
        allow create: if signedIn() && request.auth.uid == walletId;
        allow update, delete: if false;
      }
    }

    // Financial ledgers generated when orders are delivered
    match /earnings/{earningId} {
      allow read:  if signedIn() && (resource.data.deliveryAgentId == request.auth.uid || isAdmin());
      allow create: if signedIn() && (request.resource.data.deliveryAgentId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /deliveryPartnerStats/{partnerId} {
      allow read:  if signedIn() && (partnerId == request.auth.uid || isAdmin());
      allow create, update: if signedIn() && (partnerId == request.auth.uid || isAdmin());
    }

    match /settlements/{settlementId} {
      allow read:  if signedIn() && (isAdmin() || resource.data.restaurantOwnerId == request.auth.uid);
      allow create, update: if isAdmin();
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read:   if true;
      allow create: if true;
      allow update: if true;
    }

    // Promo codes — read only
    match /promoCodes/{code} {
      allow read:  if true;
      allow write: if false;
    }

    // FCM tokens
    match /fcmTokens/{tokenId} {
      allow read:   if true;
      allow write:  if true;
    }

    // App config
    match /appConfig/{doc} {
      allow read:  if true;
      allow write: if false;
    }
  }
}
